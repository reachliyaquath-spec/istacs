---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Enquiry from "../components/Enquiry.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import london from "../assets/photos/london.jpg";
import sydney from "../assets/photos/sydney.jpg";

const values = [
  { icon: "shield", title: "Plain answers", text: "If a country, course or visa route is unlikely to work for your profile, we tell you before you pay for it." },
  { icon: "users", title: "Families welcome", text: "Parents can come to counselling sessions, and many do." },
  { icon: "grad", title: "One office", text: "Admissions, visas, attestation and IELTS/PTE classes are all handled from Tolichowki." },
  { icon: "clock", title: "Intakes and deadlines", text: "We plan backwards from the intake you want, so test dates and applications fit." },
] as const;

const countries = ["USA", "Canada", "Australia", "United Kingdom", "New Zealand", "Singapore", "Ireland", "Germany"];
---

<Base
  title="About ISTA Consultancy Services | Study Abroad & Immigration, Hyderabad"
  description="ISTA Consultancy Services has guided students and families from Tolichowki, Hyderabad, through overseas education and immigration since 2013."
>
  <PageHero
    title="Guiding Hyderabad families abroad since 2013"
    lead="Admissions, visas, PR, attestation and IELTS/PTE classes for students and families, from one office in Tolichowki."
    img={london}
    crumbs={[{ label: "Home", href: "/" }, { label: "About" }]}
  />

  <section class="section">
    <div class="wrap story">
      <div>
        <h2 class="h2" data-rv>Our story</h2>
        <div class="prose story__text" data-rv>
          <p>
            ISTA Consultancy Services has been working in overseas education and immigration since {site.since}. From our office
            in Tolichowki, we work with students, families and professionals across Hyderabad.
            {/* PLACEHOLDER: who founded ISTA, and why. Ask ISTA. */}
          </p>
          <p>
            We have helped many students win admission to universities and colleges abroad, and helped families and individual
            professionals immigrate to Canada and Australia.
          </p>
        </div>
      </div>
      <figure class="story__img" data-rv>
        <Image src={sydney} alt="Sydney Opera House and Harbour Bridge at night" widths={[640, 960]} sizes="(max-width: 900px) 100vw, 40vw" />
      </figure>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-rv>Where our students have gone</h2>
        <p class="lead" data-rv>Students we have guided have won places at universities and colleges in these countries.</p>
      </div>
      <ul class="flags" data-rv>{countries.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" data-rv>How we work</h2>
        <p class="lead" data-rv>What to expect when you work with us.</p>
      </div>
      <ul class="vals">
        {
          values.map((v) => (
            <li data-rv>
              <Icon name={v.icon} size={26} />
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Enquiry title="Come and meet us" lead="Visit our Tolichowki office, call, or send your details on WhatsApp." />
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .story__text {
    margin-top: 22px;
  }
  .story__img {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .story__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .flags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .flags li {
    padding: 14px 24px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .vals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .vals li {
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .vals :global(svg) {
    color: var(--blue);
  }
  .vals h3 {
    margin-top: 18px;
    font-size: 1.3rem;
  }
  .vals p {
    margin-top: 8px;
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    .story {
      grid-template-columns: 1fr;
    }
    .story__img {
      aspect-ratio: 16 / 10;
    }
    .vals {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .vals {
      grid-template-columns: 1fr;
    }
  }
</style>
