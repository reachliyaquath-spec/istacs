---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  lead: string;
  img: ImageMetadata;
  imgAlt?: string;
  pos?: string;
  crumbs: { label: string; href?: string }[];
  cta?: { label: string; href: string };
}
const { title, lead, img, pos = "50% 50%", crumbs, cta = { label: "Book free counselling", href: "#enquire" } } = Astro.props;
---

<section class="ph" data-hero>
  <Image class="ph__img" src={img} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${pos}`} data-ph-img />
  <div class="wrap ph__in">
    <nav aria-label="Breadcrumb" class="crumbs" data-ph-rv>
      <ol>
        {
          crumbs.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))
        }
      </ol>
    </nav>
    <h1 data-ph-rv>{title}</h1>
    <p class="ph__lead" data-ph-rv>{lead}</p>
    <div class="ph__actions" data-ph-rv>
      <a class="btn btn--sun" href={cta.href}>{cta.label} <Icon name="arrow" class="arr" /></a>
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .ph {
    position: relative;
    min-height: clamp(520px, 72svh, 720px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
    isolation: isolate;
  }
  .ph__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 112%;
    object-fit: cover;
    z-index: -2;
  }
  .ph::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(6 18 32 / 0.85) 0%, rgb(6 18 32 / 0.55) 45%, rgb(6 18 32 / 0.1) 80%),
      linear-gradient(0deg, rgb(6 18 32 / 0.75) 0%, rgb(6 18 32 / 0) 50%);
  }
  .ph__in {
    padding-top: 160px;
    padding-bottom: clamp(48px, 7vw, 88px);
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0 0 22px;
    font-size: 0.9rem;
    color: #c9d8e6;
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(2.5rem, 1.3rem + 4vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 16ch;
  }
  .ph__lead {
    margin-top: 22px;
    max-width: 56ch;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.22rem);
    color: #d6e3ef;
  }
  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .ph__actions :global(.btn--glass) {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .ph__actions :global(.btn--glass:hover) {
    background: rgb(255 255 255 / 0.2);
  }
</style>
