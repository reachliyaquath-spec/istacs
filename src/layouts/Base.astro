---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Header floats over a dark full-bleed hero. All pages here have one. */
  overlay?: boolean;
}
const { title, description, overlay = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);

// Business details for Google (local search, Maps). Same 2018 details as the site.
const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://istacs.com/#business",
  name: site.name,
  url: "https://istacs.com/",
  logo: new URL("/favicon.png", Astro.site).href,
  image: ogImage.href,
  description:
    "Study abroad admissions and student visas, Australia and Canada immigration, certificate attestation, visit visas, and IELTS and PTE coaching in Hyderabad since 2013.",
  telephone: site.phone.tel,
  email: site.email,
  foundingDate: String(site.since),
  address: {
    "@type": "PostalAddress",
    streetAddress: "#8-1-21, 2nd Floor, Plot No. 7, Suryanagar Colony, Tolichowki",
    addressLocality: "Hyderabad",
    addressRegion: "Telangana",
    postalCode: "500008",
    addressCountry: "IN",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "17:00",
    },
  ],
  areaServed: "Hyderabad, Telangana, India",
  hasMap: site.mapsUrl,
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#081a2d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ISTA Consultancy Services" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ISTA Consultancy Services: study abroad and immigration consultants in Hyderabad" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js");
        // Safety net: if the motion script never starts, show all content anyway.
        setTimeout(function () {
          if (!window.__motionReady) document.documentElement.classList.remove("js");
        }, 3000);
      }
    </script>
  </head>
  <body>
    <Header overlay={overlay} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
